# Copy this file to .env and fill in real values. Never commit .env itself.

DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Leave the POSTGRES_* vars unset (or delete this whole block) to fall back
# to local SQLite automatically — good for getting started fast.
# Fill them in once you're ready to connect to Supabase/Postgres.
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_HOST=
POSTGRES_PORT=5432

CORS_ALLOWED_ORIGINS=http://localhost:5173,https://localhost:5173
